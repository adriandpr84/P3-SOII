# --- Directorios Makefile ---
code/obj/
code/bin/

# --- Binarios y Librerías  ---
*.o
*.out
*.exe
*.so
*.a
*.lib
*.dll

# --- Archivos de Prueba y Dummies ---
# Cualquier archivo que empiece por dummy_ será ignorado
**/dummy_*
# Ignora logs y resultados de ejecuciones
results_*.txt
*.log

# --- Archivos temporales de Editores ---
*~
*.swp
*.swo

# --- Configuración de Entorno e IDEs ---
.vscode/
*.pdb
*.dwo
*.d
*.sync-conflict-*
.DS_Store
.directory

# --- Datos (Libros) ---
!libros/*.txt

# --- Tests ---
code/tests/*
code/tests/build/

# Conservar tests
!code/tests/CMakeLists.txt
!code/tests/test_priority_scheduler.cpp
!code/tests/test_priority_scheduler.cpp


